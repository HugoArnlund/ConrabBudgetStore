{
    "manifest_version": 3,
    "name": "Conrab Budget Store",
    "version": "1.0.0",
    "description": "Send approved Opto accounting rows to Google Sheets.",
    
    "permissions": [
        "storage",
        "windows"
    ],

    "host_permissions": [
        "https://script.google.com/*",
        "https://chalmersstudentkar.conrabopto.com/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://chalmersstudentkar.conrabopto.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}